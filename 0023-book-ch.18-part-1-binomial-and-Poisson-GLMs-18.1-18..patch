+            ("Clone", 1): (8, 173, 165, 584, 1296, 400, 4981),
+            ("Clone", 2): (44, 209, 383, 1188, 627, 1628, 4302)}
+CONIDIA = [(s, r, t, c) for (s, r), counts in _CONIDIA.items() for t, c in zip(_TIMES, counts)]
