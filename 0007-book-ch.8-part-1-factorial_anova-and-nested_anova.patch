+"""Факторные и вложенные структуры вариантов (гл. 8.1–8.5 книги).
+
+Две точки входа:
+- ``factorial_anova`` — перекрёстная структура из 2 или 3 факторов
+  вариантов (A*B, A*B*C) с необязательным блоком (Table 8.3, 8.6, 8.8).
+  Члены для предсказания выбираются по принципу маргинальности
+  (Fig. 8.3–8.4): тестируются только члены, не маргинальные к
+  оставшимся; незначимые удаляются. Предсказания — таблицы средних
+  оставшихся членов со SE и SED по исходному ResMS (стр. 160–162).
+- ``nested_anova`` — вложенная структура Group/Member (Table 8.12),
+  в том числе контроль против остальных вариантов (Type/Treatment,
+  Table 8.16), с разбиением вложенного SS по группам (Table 8.14).
+
+Обе требуют ортогональности: каждая комбинация уровней встречается
+одинаковое число раз в каждом блоке. Неортогональные случаи — гл. 11.
+"""
+
+from __future__ import annotations
+
+from itertools import combinations
+from math import prod
+
+import numpy as np
+import pandas as pd
+import statsmodels.formula.api as smf
+from scipy import stats
+from statsmodels.stats.anova import anova_lm
+
+from core.report.schema import Estimate, Severity, StatResult
+from core.stats.blocking import _fill_residuals
+from core.stats.transforms import _LOG_BASE, TRANSFORMS, _transform_groups, back_transform
+
+_FACTOR_KEYS = ("A", "B", "C")
+_BORDERLINE_P = 0.10
+# Попарные разности в таблице средних — только для небольших таблиц.
+_MAX_CELLS_FOR_PAIRS = 12
+
+
+def factorial_anova(
+    values: list[float],
+    factor_a: list[str],
+    factor_b: list[str],
+    factor_c: list[str] | None = None,
+    block: list[str] | None = None,
+    alpha: float = 0.05,
+    transform_kind: str = "none",
+    offset: float = 0.0,
+    names: dict[str, str] | None = None,
+) -> StatResult:
+    """ANOVA для перекрёстной структуры 2–3 факторов и таблицы предсказаний (гл. 8.2–8.3).
+
+    ``names`` — подписи факторов для таблиц ({"A": "Species", ...}); по
+    умолчанию A, B, C. Члены модели всегда обозначаются буквами (A.B).
+    """
+    columns = {"A": factor_a, "B": factor_b, "C": factor_c}
+    keys = [k for k in _FACTOR_KEYS if columns[k] is not None]
+    frame = _frame(values, {k: columns[k] for k in keys}, block)
+    result = _start("factorial_anova", frame, alpha, transform_kind, offset)
+    result.parameters["factors"] = keys
+    result.parameters["factor_names"] = {k: (names or {}).get(k, k) for k in keys}
+    if not _prepare(frame, keys, transform_kind, offset, result):
+        return result
+    terms = _crossed_terms(keys)
+    formula = _rhs(frame, "*".join(f"C(f{k})" for k in keys))
+    fit, rows = _fit_terms(frame, formula, terms, result)
+    if fit is None:
+        return result
+    selected = _select_terms(terms, {r["term"]: r["p"] for r in rows}, alpha)
+    result.parameters["prediction_terms"] = selected
+    result.parameters["effects"] = _effects(frame, terms)
+    _fill_tables(frame, selected, result)
+    _flag_interaction(rows, alpha, result)
+    _fill_residuals(fit, frame, result)
+    return result
+
+
+def nested_anova(
+    values: list[float],
+    group: list[str],
+    member: list[str],
+    block: list[str] | None = None,
+    alpha: float = 0.05,
+    transform_kind: str = "none",
+    offset: float = 0.0,
+    names: dict[str, str] | None = None,
+) -> StatResult:
+    """ANOVA для вложенной структуры Group/Member с разбиением по группам (гл. 8.4–8.5).
+
+    Члены одной группы различаются парой (группа, член), поэтому номера
+    членов могут повторяться в разных группах (изоляты 1–9 и 1–4).
+    """
+    frame = _frame(values, {"G": group, "M": member}, block)
+    result = _start("nested_anova", frame, alpha, transform_kind, offset)
+    result.parameters["factor_names"] = {"G": (names or {}).get("G", "group"),
+                                         "cell": (names or {}).get("M", "member")}
+    if not _prepare(frame, ["G", "M"], transform_kind, offset, result, nested=True):
+        return result
+    frame["cell"] = frame["G"] + " / " + frame["M"]
+    rows = _nested_rows(frame, result)
+    if rows is None:
+        return result
+    fit = smf.ols(_rhs(frame, "C(cell)"), data=frame).fit()
+    result.parameters["effects"] = _nested_effects(frame)
+    _fill_group_means(frame, result)
+    _fill_tables(frame, ["cell"], result)
+    _fill_residuals(fit, frame, result)
+    return result
+
+
+# --- общая подготовка -------------------------------------------------------
+
+
+def _frame(
+    values: list[float], factors: dict[str, list[str]], block: list[str] | None
+) -> pd.DataFrame:
+    """Выровнять колонки, привести факторы к строкам, удалить строки с пропусками."""
+    data: dict[str, list] = {"y": values, **factors}
+    if block is not None:
+        data["blk"] = block
+    if len({len(v) for v in data.values()}) != 1:
+        raise ValueError("Колонки должны быть одной длины")
+    frame = pd.DataFrame(data)
+    frame["y"] = pd.to_numeric(frame["y"], errors="coerce")
+    for col in frame.columns.drop("y"):
+        frame[col] = frame[col].astype(str).str.strip().replace({"": np.nan, "nan": np.nan})
+    return frame.dropna().reset_index(drop=True)
+
+
+def _start(
+    method: str, frame: pd.DataFrame, alpha: float, kind: str, offset: float
+) -> StatResult:
+    """Проверить параметры и создать пустой результат."""
+    if not 0.0 < alpha < 1.0:
+        raise ValueError("alpha должен быть в (0, 1)")
+    if kind != "none" and kind not in TRANSFORMS:
+        raise ValueError(f"transform_kind ∈ {('none',) + TRANSFORMS}")
+    params = {"alpha": alpha, "transform": kind, "offset": offset, "blocked": "blk" in frame}
+    return StatResult(method=method, n=len(frame), parameters=params)
+
+
+def _prepare(
+    frame: pd.DataFrame,
+    names: list[str],
+    kind: str,
+    offset: float,
+    result: StatResult,
+    nested: bool = False,
+) -> bool:
+    """Проверить ортогональность дизайна и трансформировать отклик на месте."""
+    if not _is_balanced(frame, names, result, nested):
+        return False
+    if kind == "none":
+        return True
+    transformed = _transform_groups([frame["y"].to_numpy(float)], kind, offset, result)
+    if transformed is None:
+        return False
+    frame["y_raw"] = frame["y"]
+    frame["y"] = transformed[0]
+    return True
+
+
+def _is_balanced(frame: pd.DataFrame, names: list[str], result: StatResult, nested: bool) -> bool:
+    """Все комбинации присутствуют в каждом блоке одинаковое число раз (стр. 155, 172)."""
+    levels = {k: sorted(frame[k].unique(), key=_natural_key) for k in names}
+    if any(len(v) < 2 for v in levels.values()):
+        return _error(result, "factorial_too_small", "У каждого фактора нужно ≥ 2 уровней")
+    keys = names + (["blk"] if "blk" in frame else [])
+    counts = frame.groupby(keys).size()
+    n_cells = frame.groupby(names).ngroups if nested else prod(len(v) for v in levels.values())
+    n_blocks = frame["blk"].nunique() if "blk" in frame else 1
+    if len(counts) != n_cells * n_blocks or counts.nunique() != 1:
+        return _error(
+            result, "factorial_unbalanced",
+            "Не все комбинации уровней представлены одинаковое число раз в каждом "
+            "блоке: структура неортогональна (гл. 11)",
+        )
+    result.parameters["levels"] = levels
+    result.parameters["replication"] = int(counts.iloc[0]) * n_blocks
+    return True
+
+
+def _natural_key(level: str) -> tuple:
+    """Числовые уровни (5, 10, 20) — по значению, остальные — по алфавиту."""
+    try:
+        return (0, float(level), "")
+    except ValueError:
+        return (1, 0.0, level)
+
+
+def _error(result: StatResult, code: str, message: str) -> bool:
+    """Записать ошибку дизайна и вернуть False."""
+    result.add_warning(code, message, Severity.ERROR)
+    return False
+
+
+# --- перекрёстная структура ---------------------------------------------------
+
+
+def _crossed_terms(names: list[str]) -> list[str]:
+    """Члены A*B(*C) по возрастанию порядка: A, B, C, A.B, A.C, B.C, A.B.C."""
+    return [".".join(c) for order in range(1, len(names) + 1) for c in combinations(names, order)]
+
+
+def _rhs(frame: pd.DataFrame, treatment: str) -> str:
+    """y ~ [C(blk) +] <члены вариантов>."""
+    return "y ~ " + ("C(blk) + " if "blk" in frame else "") + treatment
+
+
+def _term_name(row_label: str) -> str:
+    """'C(fA):C(fB)' → 'A.B' (префикс f — см. _fit_terms)."""
+    return ".".join(part[3:-1] for part in row_label.split(":"))
+
+
+def _fit_terms(frame: pd.DataFrame, formula: str, terms: list[str], result: StatResult):
+    """Последовательная ANOVA (при ортогональности = любой порядок) и строки таблицы.
+
+    Колонки факторов в формуле получают префикс f: колонка «C» заслонила бы
+    функцию C() в patsy.
+    """
+    data = frame.rename(columns={k: f"f{k}" for k in _FACTOR_KEYS})
+    fit = smf.ols(formula, data=data).fit()
+    table = anova_lm(fit)
+    df_res, ss_res = float(table.loc["Residual", "df"]), float(table.loc["Residual", "sum_sq"])
+    if df_res < 1 or ss_res <= 1e-12 * max(1.0, float(((frame["y"] - frame["y"].mean()) ** 2).sum())):
+        _error(result, "no_residual_variation", "Нет остаточной вариации или степеней свободы")
+        return None, []
+    ms_res = ss_res / df_res
+    ss_trt = float(sum(table.loc[r, "sum_sq"] for r in table.index if r not in ("C(blk)", "Residual")))
+    rows = [_row(_term_name(r), table.loc[r], ms_res, df_res, ss_trt) for r in table.index
+            if r not in ("C(blk)", "Residual")]
+    _store_table(rows, table, frame, ms_res, df_res, result)
+    return fit, rows
+
+
+def _row(term: str, line: pd.Series, ms_res: float, df_res: float, ss_trt: float) -> dict:
+    """Строка таблицы ANOVA: df, SS, MS, F против ResMS, P, доля в TrtSS."""
+    df, ss = int(line["df"]), float(line["sum_sq"])
+    ms = ss / df
+    f = ms / ms_res
+    return {"term": term, "df": df, "ss": ss, "ms": ms, "F": f,
+            "p": float(stats.f.sf(f, df, df_res)), "ss_share": ss / ss_trt if ss_trt > 0 else None}
+
+
+def _store_table(
+    rows: list[dict], table: pd.DataFrame, frame: pd.DataFrame,
+    ms_res: float, df_res: float, result: StatResult,
+) -> None:
+    """Плоские statistics, таблица ANOVA и p_value (взаимодействие старшего порядка)."""
+    stats_ = result.statistics
+    for r in rows:
+        stats_.update({f"{k}_{r['term']}": r[k] for k in ("ss", "df", "ms", "F", "p")})
+    if "C(blk)" in table.index:
+        blk = _row("block", table.loc["C(blk)"], ms_res, df_res, 0.0)
+        stats_.update({f"{k}_block": blk[k] for k in ("ss", "df", "ms", "F", "p")})
+        rows_out = [{**blk, "ss_share": None, "stratum": "block"}]
+    else:
+        rows_out = []
+    stats_.update({"ss_resid": ms_res * df_res, "df_resid": int(df_res), "ms_resid": ms_res,
+                   "ss_total": float(((frame["y"] - frame["y"].mean()) ** 2).sum()),
+                   "df_total": len(frame) - 1})
+    result.parameters["anova_table"] = rows_out + [{**r, "stratum": "units"} for r in rows]
+    result.p_value = rows[-1]["p"]
+
+
+def _is_marginal(term: str, other: str) -> bool:
+    """Член маргинален к другому, если его факторы — собственное подмножество (стр. 155)."""
+    return set(term.split(".")) < set(other.split("."))
+
+
+def _select_terms(terms: list[str], p_values: dict[str, float], alpha: float) -> list[str]:
+    """Отбор членов для предсказания по маргинальности (Fig. 8.4, стр. 166–167)."""
+    remaining = list(terms)
+    changed = True
+    while changed:
+        changed = False
+        for term in sorted(remaining, key=lambda t: -t.count(".")):
+            eligible = not any(_is_marginal(term, u) for u in remaining if u != term)
+            if eligible and p_values[term] > alpha:
+                remaining.remove(term)
+                changed = True
+    return [t for t in remaining if not any(_is_marginal(t, u) for u in remaining if u != t)]
+
+
+def _effects(frame: pd.DataFrame, terms: list[str]) -> dict:
+    """Эффекты sum-to-zero включением–исключением маргинальных средних (стр. 156)."""
+    grand = float(frame["y"].mean())
+    out: dict = {"grand_mean": grand, "terms": {}}
+    for term in terms:
+        factors = term.split(".")
+        cells = frame.groupby(factors)["y"].mean()
+        effects = []
+        for key, _ in cells.items():
+            key = key if isinstance(key, tuple) else (key,)
+            levels = dict(zip(factors, key))
+            effects.append({"levels": levels, "effect": _effect(frame, levels, grand)})
+        out["terms"][term] = effects
+    return out
+
+
+def _effect(frame: pd.DataFrame, levels: dict[str, str], grand: float) -> float:
+    """Σ_{U⊆S} (−1)^{|S|−|U|} ȳ_U для одной ячейки члена S."""
+    names = list(levels)
+    total = 0.0
+    for order in range(len(names) + 1):
+        for subset in combinations(names, order):
+            mask = np.ones(len(frame), dtype=bool)
+            for name in subset:
+                mask &= (frame[name] == levels[name]).to_numpy()
+            mean = float(frame.loc[mask, "y"].mean()) if subset else grand
+            total += (-1) ** (len(names) - order) * mean
+    return total
+
+
+def _flag_interaction(rows: list[dict], alpha: float, result: StatResult) -> None:
+    """Пограничное взаимодействие старшего порядка: решать с учётом размера (стр. 159–160)."""
+    top = rows[-1]
+    if "." in top["term"] and alpha < top["p"] < _BORDERLINE_P:
+        result.add_warning(
+            "interaction_borderline",
+            f"Взаимодействие {top['term']} пограничное (P = {top['p']:.3f}); сравни его F с F "
+            f"главных эффектов, прежде чем исключать из предсказаний.",
+            Severity.INFO, params={"term": top["term"], "p": round(top["p"], 3)},
+        )
+    if not result.parameters["prediction_terms"]:
+        result.add_warning(
+            "no_significant_terms", "Ни один член модели не значим: таблиц средних нет",
+            Severity.INFO,
+        )
+
+
+# --- таблицы предсказанных средних --------------------------------------------
+
+
+def _fill_tables(frame: pd.DataFrame, terms: list[str], result: StatResult) -> None:
+    """Таблицы средних для выбранных членов: SE и SED по ResMS, df = ResDF (стр. 161–162)."""
+    s2, df = result.statistics["ms_resid"], result.statistics["df_resid"]
+    t_crit = float(stats.t.ppf(1 - result.parameters["alpha"] / 2, df))
+    result.statistics["t_crit"] = t_crit
+    result.parameters["tables"] = [_table(frame, term, s2, t_crit, result) for term in terms]
+
+
+def _table(frame: pd.DataFrame, term: str, s2: float, t_crit: float, result: StatResult) -> dict:
+    """Средние одного члена, их SE и ДИ, общий SED и LSD, разности с ДИ."""
+    factors = term.split(".")
+    grouped = frame.groupby(factors)["y"]
+    reps = int(grouped.size().iloc[0])
+    se, sed = float(np.sqrt(s2 / reps)), float(np.sqrt(2 * s2 / reps))
+    cells = [_cell(key, factors, float(mean), se, t_crit, result) for key, mean in grouped.mean().items()]
+    cells.sort(key=lambda c: tuple(_natural_key(v) for v in c["levels"].values()))
+    for c in cells:
+        result.estimates.append(Estimate(
+            name=c["label"], value=c["mean"], ci_lower=c["ci_lower"], ci_upper=c["ci_upper"],
+            ci_level=1 - result.parameters["alpha"], std_error=se,
+        ))
+    table = {"term": term, "replication": reps, "se": se, "sed": sed, "lsd": t_crit * sed,
+             "cells": cells}
+    if len(cells) <= _MAX_CELLS_FOR_PAIRS:
+        table["comparisons"] = _pairs(cells, sed, t_crit, result)
+    return table
+
+
+def _cell(key, factors: list[str], mean: float, se: float, t_crit: float, result: StatResult) -> dict:
+    """Одна ячейка таблицы: среднее, ДИ, при трансформации — то же на исходной шкале."""
+    key = key if isinstance(key, tuple) else (key,)
+    levels = dict(zip(factors, key))
+    cell = {"levels": levels, "label": _label(levels, result),
+            "mean": mean, "ci_lower": mean - t_crit * se, "ci_upper": mean + t_crit * se}
+    kind, offset = result.parameters["transform"], result.parameters["offset"]
+    if kind != "none":
+        back = back_transform([cell["mean"], cell["ci_lower"], cell["ci_upper"]], kind, offset)
+        cell.update({"back_mean": float(back[0]), "back_ci_lower": float(back[1]),
+                     "back_ci_upper": float(back[2])})
+    return cell
+
+
+def _label(levels: dict[str, str], result: StatResult) -> str:
+    """Подпись ячейки: «Species=vit, MateType=inter»; для групп вложенной модели — уровень."""
+    if set(levels) <= {"G", "cell"}:
+        return str(next(iter(levels.values())))
+    names = result.parameters.get("factor_names", {})
+    return ", ".join(f"{names.get(k, k)}={v}" for k, v in levels.items())
+
+
+def _pairs(cells: list[dict], sed: float, t_crit: float, result: StatResult) -> list[dict]:
+    """Разности ячеек (вторая − первая) с ДИ по LSD; для log — отношения (стр. 162)."""
+    df = result.statistics["df_resid"]
+    base = _LOG_BASE.get(result.parameters["transform"])
+    out = []
+    for first, second in combinations(cells, 2):
+        diff = second["mean"] - first["mean"]
+        row = {"group1": first["label"], "group2": second["label"], "mean_diff": diff,
+               "sed": sed, "t": diff / sed, "p_unadjusted": float(2 * stats.t.sf(abs(diff / sed), df)),
+               "ci_lower": diff - t_crit * sed, "ci_upper": diff + t_crit * sed}
+        if base is not None:
+            row.update({"ratio": base**diff, "ratio_ci_lower": base ** row["ci_lower"],
+                        "ratio_ci_upper": base ** row["ci_upper"]})
+        out.append(row)
+    return out
+
+
+# --- вложенная структура ----------------------------------------------------
+
+
+def _nested_rows(frame: pd.DataFrame, result: StatResult) -> list[dict] | None:
+    """SS групп, вложенного члена и его частей по группам через разности RSS."""
+    rss = {name: _rss(frame, rhs) for name, rhs in
+           (("blk", "1"), ("group", "C(G)"), ("cell", "C(cell)"))}
+    df_res = len(frame) - _n_params(frame, "cell")
+    if df_res < 1 or rss["cell"] <= 0:
+        _error(result, "no_residual_variation", "Нет остаточной вариации или степеней свободы")
+        return None
+    n_groups, n_cells = frame["G"].nunique(), frame["cell"].nunique()
+    if n_cells == n_groups:
+        _error(result, "nested_no_members", "Ни в одной группе нет больше одного члена")
+        return None
+    ms_res = rss["cell"] / df_res
+    rows = [_nested_row("group", rss["blk"] - rss["group"], n_groups - 1, ms_res, df_res),
+            _nested_row("group.member", rss["group"] - rss["cell"], n_cells - n_groups, ms_res, df_res)]
+    rows += _split_rows(frame, rss["group"], ms_res, df_res)
+    table = pd.DataFrame({"df": [_n_blocks(frame) - 1], "sum_sq": [_ss_blocks(frame)]},
+                         index=["C(blk)"]) if "blk" in frame else pd.DataFrame()
+    _store_table(rows[:2], table, frame, ms_res, df_res, result)
+    result.parameters["anova_table"] += [{**r, "stratum": "units"} for r in rows[2:]]
+    for r in rows[2:]:
+        result.statistics.update({f"{k}_{r['term']}": r[k] for k in ("ss", "df", "ms", "F", "p")})
+    result.p_value = rows[0]["p"]
+    return rows
+
+
+def _rss(frame: pd.DataFrame, treatment: str) -> float:
+    """Остаточная SS модели y ~ [C(blk) +] treatment."""
+    return float(smf.ols(_rhs(frame, treatment), data=frame).fit().ssr)
+
+
+def _n_params(frame: pd.DataFrame, column: str) -> int:
+    """Число параметров модели блоки + ячейки (без алиасов при ортогональности)."""
+    return frame[column].nunique() + (_n_blocks(frame) - 1)
+
+
+def _n_blocks(frame: pd.DataFrame) -> int:
+    return int(frame["blk"].nunique()) if "blk" in frame else 1
+
+
+def _ss_blocks(frame: pd.DataFrame) -> float:
+    """SS блоков = Σ n_b (ȳ_b − ȳ)²."""
+    means = frame.groupby("blk")["y"].agg(["mean", "size"])
+    return float((means["size"] * (means["mean"] - frame["y"].mean()) ** 2).sum())
+
+
+def _nested_row(term: str, ss: float, df: int, ms_res: float, df_res: float) -> dict:
+    """Строка таблицы для члена вложенной модели."""
+    ms = ss / df if df > 0 else float("nan")
+    f = ms / ms_res if df > 0 else float("nan")
+    p = float(stats.f.sf(f, df, df_res)) if df > 0 else float("nan")
+    return {"term": term, "df": df, "ss": ss, "ms": ms, "F": f, "p": p, "ss_share": None}
+
+
+def _split_rows(frame: pd.DataFrame, rss_group: float, ms_res: float, df_res: float) -> list[dict]:
+    """Вложенный SS по группам: фактор Set_r с лишним уровнем для остальных (стр. 177)."""
+    rows = []
+    for g in sorted(frame["G"].unique()):
+        mask = frame["G"] == g
+        n_members = frame.loc[mask, "cell"].nunique()
+        if n_members < 2:
+            continue
+        sub = frame.assign(set_r=np.where(mask, frame["cell"], frame["G"]))
+        ss = rss_group - _rss(sub, "C(set_r)")
+        rows.append(_nested_row(f"group.member[{g}]", ss, n_members - 1, ms_res, df_res))
+    # Если члены есть только в одной группе, её часть совпадает с group.member.
+    return rows if len(rows) > 1 else []
+
+
+def _nested_effects(frame: pd.DataFrame) -> dict:
+    """Родительские эффекты групп и вложенные эффекты членов (Table 8.11)."""
+    grand = float(frame["y"].mean())
+    group_means = frame.groupby("G")["y"].mean()
+    cells = frame.groupby(["G", "M"])["y"].mean()
+    nested = [{"group": g, "member": m, "effect": float(v - group_means[g]),
+               "treatment_effect": float(v - grand)} for (g, m), v in cells.items()]
+    return {"grand_mean": grand,
+            "group": {g: float(v - grand) for g, v in group_means.items()},
+            "group.member": nested}
+
+
+def _fill_group_means(frame: pd.DataFrame, result: StatResult) -> None:
+    """Средние групп при неравном числе членов: SE_g и SED_gh по своим n (стр. 176)."""
+    s2, df = result.statistics["ms_resid"], result.statistics["df_resid"]
+    t_crit = float(stats.t.ppf(1 - result.parameters["alpha"] / 2, df))
+    summary = frame.groupby("G")["y"].agg(["mean", "size"])
+    cells = []
+    for g, row in summary.iterrows():
+        se = float(np.sqrt(s2 / row["size"]))
+        cell = _cell((g,), ["G"], float(row["mean"]), se, t_crit, result)
+        cells.append({**cell, "n": int(row["size"]), "se": se})
+    pairs = []
+    for a, b in combinations(cells, 2):
+        sed = float(np.sqrt(s2 * (1 / a["n"] + 1 / b["n"])))
+        pairs.extend(_pairs([a, b], sed, t_crit, result))
+    result.parameters["group_means"] = {"cells": cells, "comparisons": pairs}
