+def test_book_table_8_14_nested_split_by_group():
+    """Table 8.14 (стр. 178): Species.TypeA 8 df F 20.349; Species.TypeB 3 df F 1.541, P 0.230."""
+    r = _brassica_result()
+    a, b = _row(r, "group.member[A]"), _row(r, "group.member[B]")
+    assert (a["df"], a["ss"], a["F"]) == pytest.approx((8, 23.4012, 20.349), abs=5e-4)
+    assert (b["df"], b["ss"], b["F"], b["p"]) == pytest.approx((3, 0.6643, 1.541, 0.230), abs=5e-4)
+
+
+def test_book_example_8_3a_group_means_and_effects():
+    """Стр. 176: A −1.341 (20.7 %), B −2.060 (11.3 %), SED 0.1315; Table 8.11: 0.221 и −0.498."""
+    r = _brassica_result()
+    cells = {c["label"]: c for c in r.parameters["group_means"]["cells"]}
+    assert (cells["A"]["mean"], cells["A"]["back_mean"]) == pytest.approx((-1.341, 20.7), abs=0.05)
+    assert (cells["B"]["mean"], cells["B"]["back_mean"]) == pytest.approx((-2.060, 11.3), abs=0.05)
+    assert r.parameters["group_means"]["comparisons"][0]["sed"] == pytest.approx(0.1315, abs=5e-5)
+    eff = r.parameters["effects"]
+    # B = (−0.715 − 0.565 − 0.101 − 0.609)/4 = −0.4975: книга округлила вниз.
+    assert eff["group"] == pytest.approx({"A": 0.221, "B": -0.4975}, abs=5e-4)
+    a9 = next(e for e in eff["group.member"] if e["group"] == "A" and e["member"] == "9")
+    assert (a9["treatment_effect"], a9["effect"]) == pytest.approx((-1.110, -1.331), abs=6e-4)
+    # A6: книга печатает 1.555, точное 1.7771 − 0.2211 = 1.5561 (округление книги).
+    a6 = next(e for e in eff["group.member"] if e["group"] == "A" and e["member"] == "6")
+    assert a6["effect"] == pytest.approx(a6["treatment_effect"] - eff["group"]["A"])
+
+
+def test_book_table_8_16_control_vs_treated():
+    """Table 8.16 (стр. 182): Type F 35.972; Type.Fungicide 3 df F 0.778, P 0.529."""
+    values, trt, blocks = [], [], []
+    for b, (layout, yields) in POTATO.items():
+        values += yields
+        trt += layout
+        blocks += [str(b)] * len(layout)
+    types = ["Control" if t == "Control" else "Treated" for t in trt]
+    r = nested_anova(values, types, trt, block=blocks)
+    assert (_row(r, "group")["ss"], _row(r, "group")["F"]) == pytest.approx((125294.45, 35.972), abs=5e-3)
+    nested = _row(r, "group.member")
+    assert (nested["df"], nested["ss"], nested["F"], nested["p"]) == pytest.approx(
+        (3, 8124.75, 0.778, 0.529), abs=5e-3)
+    assert not any(row["term"].startswith("group.member[") for row in r.parameters["anova_table"])
+    eff = r.parameters["effects"]  # Table 8.15
+    assert eff["group"] == pytest.approx({"Control": -158.3, "Treated": 39.6}, abs=0.05)
+    control = next(e for e in eff["group.member"] if e["member"] == "Control")
+    assert control["effect"] == 0.0  # алиасирован с группой (стр. 181)
+
+
+def test_nested_requires_some_group_with_members():
+    r = nested_anova([1.0, 2, 3, 4], list("aabb"), list("xxyy"))
+    assert "nested_no_members" in _codes(r)
+
+
+def test_results_are_json_serializable():
+    for result in (_beetles(), _ladybird_result(), _brassica_result()):
+        json.dumps(result.to_dict())
