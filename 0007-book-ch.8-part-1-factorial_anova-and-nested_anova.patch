+def test_matches_statsmodels_three_factors_with_blocks():
+    """Случайный сбалансированный 2×3×2 в 3 блоках по 2 повтора: SS и F как у anova_lm."""
+    rng = np.random.default_rng(8)
+    rows = [(a, b, c, blk) for a, b, c, blk, _ in product("xy", "pqr", "uv", "123", range(2))]
+    frame = pd.DataFrame(rows, columns=["a", "b", "c", "blk"])
+    frame["y"] = rng.normal(10, 2, len(frame)) + (frame["a"] == "y") * 1.5
+    r = factorial_anova(frame["y"].tolist(), frame["a"].tolist(), frame["b"].tolist(),
+                        frame["c"].tolist(), block=frame["blk"].tolist())
+    ref = anova_lm(smf.ols("y ~ C(blk) + C(a)*C(b)*C(c)", frame).fit())
+    terms = {"C(blk)": "block", "C(a)": "A", "C(b)": "B", "C(a):C(b):C(c)": "A.B.C"}
+    for label, term in terms.items():
+        assert _row(r, term)["ss"] == pytest.approx(ref.loc[label, "sum_sq"])
+        assert _row(r, term)["F"] == pytest.approx(ref.loc[label, "F"])
+
+
+def test_marginality_selection_figure_8_4():
+    """Fig. 8.4: значимы только A.C и B → предсказания по таблицам A.C и B."""
+    terms = ["A", "B", "C", "A.B", "A.C", "B.C", "A.B.C"]
+    p = {"A": 0.5, "B": 0.01, "C": 0.6, "A.B": 0.3, "A.C": 0.02, "B.C": 0.4, "A.B.C": 0.7}
+    assert sorted(_select_terms(terms, p, 0.05)) == ["A.C", "B"]
+    # Главный эффект A не проверяется, пока A.C в модели (стр. 166).
+    assert sorted(_select_terms(terms, {**p, "A.C": 0.01, "A": 0.9}, 0.05)) == ["A.C", "B"]
+    assert _select_terms(terms, {t: 0.9 for t in terms}, 0.05) == []
+
+
+def test_unbalanced_design_rejected():
+    """Неравная повторность или пропущенная комбинация → ошибка (неортогонально, гл. 11)."""
+    a, b, y = list("xxxyyy"), list("pqppqq"), [1.0, 2, 3, 4, 5, 6]
+    r = factorial_anova(y, a, b)
+    assert "factorial_unbalanced" in _codes(r)
+    r2 = factorial_anova([1.0, 2, 3, 4], list("xxyy"), list("pppq"))
+    assert "factorial_unbalanced" in _codes(r2)
+
+
+def test_single_level_factor_rejected():
+    r = factorial_anova([1.0, 2, 3, 4], list("xxxx"), list("pqpq"))
+    assert [w.severity for w in r.warnings] == [Severity.ERROR]
+    assert "factorial_too_small" in _codes(r)
