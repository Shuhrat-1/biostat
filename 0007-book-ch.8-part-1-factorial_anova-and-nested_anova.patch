+
+
+def _ladybird() -> pd.DataFrame:
+    rows = []
+    for line in LADYBIRD.splitlines():
+        lb, cad, *nums = line.split()
+        for j, (host, run) in enumerate([("Trefoil", 1), ("Trefoil", 2), ("Bean", 1), ("Bean", 2)]):
+            rows.append((host, cad, lb, str(run), int(nums[2 * j]), int(nums[2 * j + 1])))
+    frame = pd.DataFrame(rows, columns=["host", "cadaver", "ladybird", "run", "infected", "live"])
+    frame["percent"] = 100 * (frame["infected"] + 1) / (frame["live"] + 2)  # стр. 168
+    return frame
+
+
+def _ladybird_result():
+    f = _ladybird()
+    return factorial_anova(
+        f["percent"].tolist(), f["host"].tolist(), f["cadaver"].tolist(), f["ladybird"].tolist(),
+        block=f["run"].tolist(), transform_kind="logit_pct",
+    )
+
+
+def _brassica_result():
+    values, species, isolate, rep = [], [], [], []
+    for line in BRASSICA.splitlines():
+        parts = line.split()
+        for r in range(3):
+            iso, resistant = parts[1 + 2 * r], int(parts[2 + 2 * r])
+            values.append(100 * (resistant + 1) / (SEEDLINGS[r + 1] + 2))  # стр. 174
+            species.append(iso[0]), isolate.append(iso[1:]), rep.append(str(r + 1))
+    return nested_anova(values, species, isolate, block=rep, transform_kind="logit_pct")
+
+
+def _herbicide_result():
+    values, pop, herb, rep = [], [], [], []
+    for line in HERBICIDE.splitlines():
+        p, h, *weights = line.split()
+        for k, w in enumerate(weights):
+            values.append(float(w)), pop.append(p), herb.append(h), rep.append(str(k + 1))
+    return factorial_anova(values, herb, pop, block=rep, transform_kind="sqrt")
+
+
+def _row(result, term):
+    return next(r for r in result.parameters["anova_table"] if r["term"] == term)
+
+
+def _table(result, term):
+    return next(t for t in result.parameters["tables"] if t["term"] == term)
+
+
+def _codes(result) -> set[str]:
+    return {w.code for w in result.warnings}
+
+
+def test_book_table_8_4_two_way_anova():
+    """Table 8.4 (стр. 160): Species F 37.932, MateType F 15.992, S.M F 3.837, P 0.058."""
+    r = _beetles()
+    s = r.statistics
+    assert (s["ss_A"], s["ss_B"], s["ss_A.B"]) == pytest.approx((0.90307, 0.38073, 0.09135), abs=5e-6)
+    assert (s["F_A"], s["F_B"], s["F_A.B"]) == pytest.approx((37.932, 15.992, 3.837), abs=5e-4)
+    assert s["p_A.B"] == pytest.approx(0.058, abs=5e-4)
+    assert (s["ss_resid"], s["df_resid"], s["ms_resid"]) == pytest.approx((0.8571, 36, 0.0238), abs=5e-5)
+    assert s["ss_total"] == pytest.approx(2.2322, abs=5e-5)
+    assert r.p_value == pytest.approx(s["p_A.B"])
+
+
+def test_book_table_8_2_effects():
+    """Table 8.2 (стр. 157): μ̂ = 1.8085, Species₁ = −0.1503, MateType₁ = −0.0976, (Sp.MT)₁₁ = −0.0478."""
+    eff = _beetles().parameters["effects"]
+    assert eff["grand_mean"] == pytest.approx(1.8085, abs=5e-5)
+    first = {t: eff["terms"][t][0]["effect"] for t in ("A", "B", "A.B")}
+    assert first == pytest.approx({"A": -0.1503, "B": -0.0976, "A.B": -0.0478}, abs=5e-5)
+    for term in ("A", "B", "A.B"):  # sum-to-zero
+        assert sum(e["effect"] for e in eff["terms"][term]) == pytest.approx(0.0, abs=1e-12)
+
+
+def test_book_example_8_1c_borderline_interaction_dropped():
+    """8.1C: P = 0.058 > 0.05 — предсказания по главным эффектам, но с пометкой (стр. 159–160)."""
+    r = _beetles()
+    assert r.parameters["prediction_terms"] == ["A", "B"]
+    assert "interaction_borderline" in _codes(r)
+    assert _beetles(alpha=0.10).parameters["prediction_terms"] == ["A.B"]
+
+
+def test_book_table_8_5_marginal_means():
+    """Table 8.5 (стр. 162): разности 0.301 и 0.195, SED 0.0488, LSD 0.0990, ДИ и отношения."""
+    r = _beetles()
+    species, mate = _table(r, "A"), _table(r, "B")
+    assert [c["mean"] for c in species["cells"]] == pytest.approx([1.658, 1.959], abs=5e-4)
+    assert [c["mean"] for c in mate["cells"]] == pytest.approx([1.711, 1.906], abs=5e-4)
+    assert species["sed"] == pytest.approx(0.0488, abs=5e-5)
+    assert species["lsd"] == pytest.approx(0.0990, abs=5e-5)
+    assert species["replication"] == 20
+    sp, mt = species["comparisons"][0], mate["comparisons"][0]
+    assert (sp["mean_diff"], mt["mean_diff"]) == pytest.approx((0.301, 0.195), abs=5e-4)
+    assert (sp["ci_lower"], sp["ci_upper"]) == pytest.approx((0.202, 0.399), abs=5e-4)
+    assert (mt["ci_lower"], mt["ci_upper"]) == pytest.approx((0.096, 0.294), abs=5e-4)
+    # Книга печатает 2.52, но 10^0.399 = 2.506 (её же граница ДИ) — опечатка округления.
+    assert (sp["ratio_ci_lower"], sp["ratio_ci_upper"]) == pytest.approx((1.59, 2.51), abs=5e-3)
+    assert (mt["ratio_ci_lower"], mt["ratio_ci_upper"]) == pytest.approx((1.25, 1.97), abs=5e-3)
+
+
+def test_cell_means_back_transformed_and_labelled():
+    """Таблица ячеек при alpha = 0.10: 10^среднее = геометрическое среднее (Table 6.1)."""
+    cells = _table(_beetles(alpha=0.10), "A.B")["cells"]
+    assert cells[0]["label"] == "Species=vit, MateType=inter"
+    assert [c["back_mean"] for c in cells] == pytest.approx([32.6, 63.6, 81.1, 102.0], abs=0.05)
+
+
+def test_book_table_8_8_three_way_with_runs():
+    """Table 8.8 (стр. 169): прогоны как блоки, 7 членов, остаток 59 df."""
+    r = _ladybird_result()
+    expected = {"block": (1, 0.0677, 0.294), "A": (1, 13.5992, 59.172), "B": (2, 17.0274, 37.044),
+                "C": (1, 11.0907, 48.257), "A.B": (2, 0.3078, 0.670), "A.C": (1, 0.2279, 0.992),
+                "B.C": (2, 1.7349, 3.774), "A.B.C": (2, 0.1999, 0.435)}
+    for term, (df, ss, f) in expected.items():
+        row = _row(r, term)
+        assert row["df"] == df
+        assert (row["ss"], row["F"]) == pytest.approx((ss, f), abs=5e-4)
+    assert (r.statistics["df_resid"], r.statistics["ss_resid"]) == pytest.approx((59, 13.5596), abs=5e-5)
+    assert r.statistics["ss_total"] == pytest.approx(57.8151, abs=5e-5)
+    assert _row(r, "B.C")["p"] == pytest.approx(0.029, abs=5e-4)
+
+
+def test_book_table_8_9_prediction_tables():
+    """Table 8.9 (стр. 170): Cadaver × Ladybird и Host; SED 0.1957 и 0.1130; проценты."""
+    r = _ladybird_result()
+    assert sorted(r.parameters["prediction_terms"]) == ["A", "B.C"]
+    cl, host = _table(r, "B.C"), _table(r, "A")
+    assert (cl["sed"], host["sed"]) == pytest.approx((0.1957, 0.1130), abs=5e-5)
+    got = {(c["levels"]["B"], c["levels"]["C"]): (c["mean"], c["back_mean"]) for c in cl["cells"]}
+    book = {("5", "+"): (-1.454, 18.9), ("10", "+"): (-1.033, 26.3), ("20", "+"): (0.044, 51.1),
+            ("5", "-"): (-2.038, 11.5), ("10", "-"): (-1.580, 17.1), ("20", "-"): (-1.179, 23.5)}
+    for key, (mean, pct) in book.items():
+        assert got[key] == pytest.approx((mean, pct), abs=(5e-4 + 0.05))
+    hosts = {c["levels"]["A"]: (c["mean"], c["back_mean"]) for c in host["cells"]}
+    assert host["cells"][0]["label"] == "A=Bean"
+    assert hosts["Trefoil"] == pytest.approx((-1.641, 16.2), abs=0.05)
+    assert hosts["Bean"] == pytest.approx((-0.772, 31.6), abs=0.05)
+    assert [c["levels"]["B"] for c in cl["cells"][:3]] == ["5", "5", "10"]  # уровни по числу
+
+
+def test_book_table_8_22_herbicide_rows():
+    """Table 8.22 (стр. 189), √-шкала: Rep, Herbicide, Population, взаимодействие, остаток."""
+    r = _herbicide_result()
+    expected = {"block": (4, 1.3111, 2.671), "A": (2, 15.7207, 64.053),
+                "B": (8, 3.5080, 3.573), "A.B": (16, 13.9437, 7.102)}
+    for term, (df, ss, f) in expected.items():
+        row = _row(r, term)
+        assert (row["df"], row["ss"], row["F"]) == pytest.approx((df, ss, f), abs=5e-4)
+    assert (r.statistics["df_resid"], r.statistics["ss_resid"]) == pytest.approx((104, 12.7626), abs=5e-5)
+    main = [e["effect"] for e in r.parameters["effects"]["terms"]["A"]]  # Table 8.21
+    assert main == pytest.approx([0.093, -0.457, 0.363], abs=5e-4)
+    assert r.parameters["prediction_terms"] == ["A.B"]
+    assert "comparisons" not in _table(r, "A.B")  # 27 ячеек: без попарной таблицы
+
