  "\\eta^2 = \\frac{SS_B}{SS_T} = 0.87,\\qquad \\omega^2 = \\frac{SS_B-(t-1)\\,MS_W}{SS_T+MS_W} = 0.84": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>=</mo><mfrac><mrow><mi>S</mi><msub><mi>S</mi><mi>B</mi></msub></mrow><mrow><mi>S</mi><msub><mi>S</mi><mi>T</mi></msub></mrow></mfrac><mo>=</mo><mn>0.87</mn><mo separator=\"true\">,</mo><mspace width=\"2em\"/><msup><mi>ω</mi><mn>2</mn></msup><mo>=</mo><mfrac><mrow><mi>S</mi><msub><mi>S</mi><mi>B</mi></msub><mo>−</mo><mo stretchy=\"false\">(</mo><mi>t</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mtext> </mtext><mi>M</mi><msub><mi>S</mi><mi>W</mi></msub></mrow><mrow><mi>S</mi><msub><mi>S</mi><mi>T</mi></msub><mo>+</mo><mi>M</mi><msub><mi>S</mi><mi>W</mi></msub></mrow></mfrac><mo>=</mo><mn>0.84</mn></mrow><annotation encoding=\"application/x-tex\">\\eta^2 = \\frac{SS_B}{SS_T} = 0.87,\\qquad \\omega^2 = \\frac{SS_B-(t-1)\\,MS_W}{SS_T+MS_W} = 0.84</annotation></semantics></math></span>",
  "\\mathrm{SE}(\\bar y_{i\\cdot}) = \\sqrt{\\frac{MS_W}{n_i}},\\quad \\mathrm{SED} = \\sqrt{MS_W\\left(\\frac1{n_i}+\\frac1{n_k}\\right)},\\quad \\bar y_{i\\cdot} \\pm t_{0.975;\\,N-t}\\,\\mathrm{SE},\\quad \\mathrm{LSD} = t_{0.975;\\,N-t}\\,\\mathrm{SED}": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">E</mi></mrow><mo stretchy=\"false\">(</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mi>i</mi><mo>⋅</mo></mrow></msub><mo stretchy=\"false\">)</mo><mo>=</mo><msqrt><mfrac><mrow><mi>M</mi><msub><mi>S</mi><mi>W</mi></msub></mrow><msub><mi>n</mi><mi>i</mi></msub></mfrac></msqrt><mo separator=\"true\">,</mo><mspace width=\"1em\"/><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">E</mi><mi mathvariant=\"normal\">D</mi></mrow><mo>=</mo><msqrt><mrow><mi>M</mi><msub><mi>S</mi><mi>W</mi></msub><mrow><mo fence=\"true\">(</mo><mfrac><mn>1</mn><msub><mi>n</mi><mi>i</mi></msub></mfrac><mo>+</mo><mfrac><mn>1</mn><msub><mi>n</mi><mi>k</mi></msub></mfrac><mo fence=\"true\">)</mo></mrow></mrow></msqrt><mo separator=\"true\">,</mo><mspace width=\"1em\"/><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mi>i</mi><mo>⋅</mo></mrow></msub><mo>±</mo><msub><mi>t</mi><mrow><mn>0.975</mn><mo separator=\"true\">;</mo><mtext> </mtext><mi>N</mi><mo>−</mo><mi>t</mi></mrow></msub><mtext> </mtext><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">E</mi></mrow><mo separator=\"true\">,</mo><mspace width=\"1em\"/><mrow><mi mathvariant=\"normal\">L</mi><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">D</mi></mrow><mo>=</mo><msub><mi>t</mi><mrow><mn>0.975</mn><mo separator=\"true\">;</mo><mtext> </mtext><mi>N</mi><mo>−</mo><mi>t</mi></mrow></msub><mtext> </mtext><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">E</mi><mi mathvariant=\"normal\">D</mi></mrow></mrow><annotation encoding=\"application/x-tex\">\\mathrm{SE}(\\bar y_{i\\cdot}) = \\sqrt{\\frac{MS_W}{n_i}},\\quad \\mathrm{SED} = \\sqrt{MS_W\\left(\\frac1{n_i}+\\frac1{n_k}\\right)},\\quad \\bar y_{i\\cdot} \\pm t_{0.975;\\,N-t}\\,\\mathrm{SE},\\quad \\mathrm{LSD} = t_{0.975;\\,N-t}\\,\\mathrm{SED}</annotation></semantics></math></span>",
  "\\underbrace{\\sum_{i}\\sum_{j}(y_{ij}-\\bar y_{\\cdot\\cdot})^2}_{SS_T} = \\underbrace{\\sum_{i} n_i(\\bar y_{i\\cdot}-\\bar y_{\\cdot\\cdot})^2}_{SS_B} + \\underbrace{\\sum_{i}\\sum_{j}(y_{ij}-\\bar y_{i\\cdot})^2}_{SS_W}": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><munder><munder><mrow><munder><mo>∑</mo><mi>i</mi></munder><munder><mo>∑</mo><mi>j</mi></munder><mo stretchy=\"false\">(</mo><msub><mi>y</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub><mo>−</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mo>⋅</mo><mo>⋅</mo></mrow></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow><mo stretchy=\"true\">⏟</mo></munder><mrow><mi>S</mi><msub><mi>S</mi><mi>T</mi></msub></mrow></munder><mo>=</mo><munder><munder><mrow><munder><mo>∑</mo><mi>i</mi></munder><msub><mi>n</mi><mi>i</mi></msub><mo stretchy=\"false\">(</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mi>i</mi><mo>⋅</mo></mrow></msub><mo>−</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mo>⋅</mo><mo>⋅</mo></mrow></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow><mo stretchy=\"true\">⏟</mo></munder><mrow><mi>S</mi><msub><mi>S</mi><mi>B</mi></msub></mrow></munder><mo>+</mo><munder><munder><mrow><munder><mo>∑</mo><mi>i</mi></munder><munder><mo>∑</mo><mi>j</mi></munder><mo stretchy=\"false\">(</mo><msub><mi>y</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub><mo>−</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mi>i</mi><mo>⋅</mo></mrow></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow><mo stretchy=\"true\">⏟</mo></munder><mrow><mi>S</mi><msub><mi>S</mi><mi>W</mi></msub></mrow></munder></mrow><annotation encoding=\"application/x-tex\">\\underbrace{\\sum_{i}\\sum_{j}(y_{ij}-\\bar y_{\\cdot\\cdot})^2}_{SS_T} = \\underbrace{\\sum_{i} n_i(\\bar y_{i\\cdot}-\\bar y_{\\cdot\\cdot})^2}_{SS_B} + \\underbrace{\\sum_{i}\\sum_{j}(y_{ij}-\\bar y_{i\\c