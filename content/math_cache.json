  "\\nu_1 = t-1,\\qquad \\nu_2 = \\frac{t^2-1}{3\\Lambda};\\qquad F_W = 982.5,\\quad \\nu_2 = 16.2,\\quad P = 1.2\\cdot10^{-17}": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msub><mi>ν</mi><mn>1</mn></msub><mo>=</mo><mi>t</mi><mo>−</mo><mn>1</mn><mo separator=\"true\">,</mo><mspace width=\"2em\"/><msub><mi>ν</mi><mn>2</mn></msub><mo>=</mo><mfrac><mrow><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><mrow><mn>3</mn><mi mathvariant=\"normal\">Λ</mi></mrow></mfrac><mo separator=\"true\">;</mo><mspace width=\"2em\"/><msub><mi>F</mi><mi>W</mi></msub><mo>=</mo><mn>982.5</mn><mo separator=\"true\">,</mo><mspace width=\"1em\"/><msub><mi>ν</mi><mn>2</mn></msub><mo>=</mo><mn>16.2</mn><mo separator=\"true\">,</mo><mspace width=\"1em\"/><mi>P</mi><mo>=</mo><mn>1.2</mn><mo>⋅</mo><mn>1</mn><msup><mn>0</mn><mrow><mo>−</mo><mn>17</mn></mrow></msup></mrow><annotation encoding=\"application/x-tex\">\\nu_1 = t-1,\\qquad \\nu_2 = \\frac{t^2-1}{3\\Lambda};\\qquad F_W = 982.5,\\quad \\nu_2 = 16.2,\\quad P = 1.2\\cdot10^{-17}</annotation></semantics></math></span>",
  "\\underbrace{\\sum_{i}\\sum_{j}(y_{ij}-\\bar y_{\\cdot\\cdot})^2}_{SS_T} = \\underbrace{\\sum_{i} n_i(\\bar y_{i\\cdot}-\\bar y_{\\cdot\\cdot})^2}_{SS_B} + \\underbrace{\\sum_{i}\\sum_{j}(y_{ij}-\\bar y_{i\\cdot})^2}_{SS_W}": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><munder><munder><mrow><munder><mo>∑</mo><mi>i</mi></munder><munder><mo>∑</mo><mi>j</mi></munder><mo stretchy=\"false\">(</mo><msub><mi>y</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub><mo>−</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mo>⋅</mo><mo>⋅</mo></mrow></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow><mo stretchy=\"true\">⏟</mo></munder><mrow><mi>S</mi><msub><mi>S</mi><mi>T</mi></msub></mrow></munder><mo>=</mo><munder><munder><mrow><munder><mo>∑</mo><mi>i</mi></munder><msub><mi>n</mi><mi>i</mi></msub><mo stretchy=\"false\">(</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mi>i</mi><mo>⋅</mo></mrow></msub><mo>−</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mo>⋅</mo><mo>⋅</mo></mrow></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow><mo stretchy=\"true\">⏟</mo></munder><mrow><mi>S</mi><msub><mi>S</mi><mi>B</mi></msub></mrow></munder><mo>+</mo><munder><munder><mrow><munder><mo>∑</mo><mi>i</mi></munder><munder><mo>∑</mo><mi>j</mi></munder><mo stretchy=\"false\">(</mo><msub><mi>y</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub><mo>−</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mi>i</mi><mo>⋅</mo></mrow></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow><mo stretchy=\"true\">⏟</mo></munder><mrow><mi>S</mi><msub><mi>S</mi><mi>W</mi></msub></mrow></munder></mrow><annotation encoding=\"application/x-tex\">\\underbrace{\\sum_{i}\\sum_{j}(y_{ij}-\\bar y_{\\cdot\\cdot})^2}_{SS_T} = \\underbrace{\\sum_{i} n_i(\\bar y_{i\\cdot}-\\bar y_{\\cdot\\cdot})^2}_{SS_B} + \\underbrace{\\sum_{i}\\sum_{j}(y_{ij}-\\bar y_{i\\cdot})^2}_{SS_W}</annotation></semantics></math></span>",
  "s_p^2 = \\frac{(n_1-1)\\,s_1^2 + (n_2-1)\\,s_2^2}{n_1+n_2-2},\\qquad \\mathrm{SED} = \\sqrt{s_p^2\\left(\\frac1{n_1}+\\frac1{n_2}\\right)}": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msubsup><mi>s</mi><mi>p</mi><mn>2</mn></msubsup><mo>=</mo><mfrac><mrow><mo stretchy=\"false\">(</mo><msub><mi>n</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mtext> </mtext><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mo>+</mo><mo stretchy=\"false\">(</mo><msub><mi>n</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mtext> </mtext><msubsup><mi>s</mi><mn>2</mn><mn>2</mn></msubsup></mrow><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><msub><mi>n</mi><mn>2</mn></msub><mo>−</mo><mn>2</mn></mrow></mfrac><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">E</mi><mi mathvariant=\"normal\">D</mi></mrow><mo>=</mo><msqrt><mrow><msubsup><mi>s</mi><mi>p</mi><mn>2</mn></msubsup><mrow><mo fence=\"true\">(</mo><mfrac><mn>1</mn><msub><mi>n</mi><mn>1</mn></msub></mfrac><mo>+</mo><mfrac><mn>1</mn><msub><mi>n</mi><mn>2</mn></msub></mfrac><mo fence=\"true\">)</mo></mrow></mrow></msqrt></mrow><annotation encoding=\"application/x-tex\">s_p^2 = \\frac{(n_1-1)\\,s_1^2 + (n_2-1)\\,s_2^2}{n_1+n_2-2},\\qquad \\mathrm{SED} = \\sqrt{s_p^2\\left(\\frac1{n_1}+\\frac1{n_2}\\right)}</annotation></semantics></math></span>",
  "t = \\frac{\\bar y_{1\\cdot}-\\bar y_{2\\cdot}}{\\mathrm{SED}} = \\frac{5.30-4.75}{0.15} = 3.67,\\qquad n_1+n_2-2 = 10\\ \\text{df},\\qquad P = 0.0043": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>t</mi><mo>=</mo><mfrac><mrow><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mn>1</mn><mo>⋅</mo></mrow></msub><mo>−</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mn>2</mn><mo>⋅</mo></mrow></msub></mrow><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">E</mi><mi mathvariant=\"normal\">D</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>5.30</mn><mo>−</mo><mn>4.75</mn></mrow><mn>0.15</mn></mfrac><mo>=</mo><mn>3.67</mn><mo separator=\"true\">,</mo><mspace width=\"2em\"/><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><msub><mi>n</mi><mn>2</mn></msub><mo>−</mo><mn>2</mn><mo>=</mo><mn>10</mn><mtext> df</mtext><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi>P</mi><mo>=</mo><mn>0.0043</mn></mrow><annotation encoding=\"application/x-tex\">t = \\frac{\\bar y_{1\\cdot}-\\bar y_{2\\cdot}}{\\mathrm{SED}} = \\frac{5.30-4.75}{0.15} = 3.67,\\qquad n_1+n_2-2 = 10\\ \\text{df},\\qquad P = 0.0043</annotation></semantics></math></span>",
  "t_W = \\frac{\\bar y_{1\\cdot}-\\bar y_{2\\cdot}}{\\sqrt{s_1^2/n_1 + s_2^2/n_2}},\\qquad \\nu = \\frac{\\left(s_1^2/n_1 + s_2^2/n_2\\right)^2}{\\dfrac{(s_1^2/n_1)^2}{n_1-1} + \\dfrac{(s_2^2/n_2)^2}{n_2-1}}": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msub><mi>t</mi><mi>W</mi></msub><mo>=</mo><mfrac><mrow><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mn>1</mn><mo>⋅</mo></mrow></msub><mo>−</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mn>2</mn><mo>⋅</mo></mrow></msub></mrow><msqrt><mrow><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mi mathvariant=\"normal\">/</mi><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><msubsup><mi>s</mi><mn>2</mn><mn>2</mn></msubsup><mi mathvariant=\"normal\">/</mi><msub><mi>n</mi><mn>2</mn></msub></mrow></msqrt></mfrac><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi>ν</mi><mo>=</mo><mfrac><msup><mrow><mo fence=\"true\">(</mo><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mi mathvariant=\"normal\">/</mi><msub><mi>n</mi><mn>1</mn></msub><mo>+</mo><msubsup><mi>s</mi><mn>2</mn><mn>2</mn></msubsup><mi mathvariant=\"normal\">/</mi><msub><mi>n</mi><mn>2</mn></msub><mo fence=\"true\">)</mo></mrow><mn>2</mn></msup><mrow><mfrac><mrow><mo stretchy=\"false\">(</mo><msubsup><mi>s</mi><mn>1</mn><mn>2</mn></msubsup><mi mathvariant=\"normal\">/</mi><msub><mi>n</mi><mn>1</mn></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow><mrow><msub><mi>n</mi><mn>1</mn></msub><mo>−</mo><mn>1</mn></mrow></mfrac><mo>+</mo><mfrac><mrow><mo stretchy=\"false\">(</mo><msubsup><mi>s</mi><mn>2</mn><mn>2</mn></msubsup><mi mathvariant=\"normal\">/</mi><msub><mi>n</mi><mn>2</mn></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow><mrow><msub><mi>n</mi><mn>2</mn></msub><mo>−</mo><mn>1</mn></mrow></mfrac></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">t_W = \\frac{\\bar y_{1\\cdot}-\\bar y_{2\\cdot}}{\\sqrt{s_1^2/n_1 + s_