  "F = \\frac{MS_B}{MS_W} = \\frac{SS_B/(t-1)}{SS_W/(N-t)} = \\frac{5.53/2}{0.85/15} = \\frac{2.765}{0.0567} = 48.8,\\qquad P = 2.7\\cdot10^{-7}": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>F</mi><mo>=</mo><mfrac><mrow><mi>M</mi><msub><mi>S</mi><mi>B</mi></msub></mrow><mrow><mi>M</mi><msub><mi>S</mi><mi>W</mi></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>S</mi><msub><mi>S</mi><mi>B</mi></msub><mi mathvariant=\"normal\">/</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mi>S</mi><msub><mi>S</mi><mi>W</mi></msub><mi mathvariant=\"normal\">/</mi><mo stretchy=\"false\">(</mo><mi>N</mi><mo>−</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>5.53</mn><mi mathvariant=\"normal\">/</mi><mn>2</mn></mrow><mrow><mn>0.85</mn><mi mathvariant=\"normal\">/</mi><mn>15</mn></mrow></mfrac><mo>=</mo><mfrac><mn>2.765</mn><mn>0.0567</mn></mfrac><mo>=</mo><mn>48.8</mn><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi>P</mi><mo>=</mo><mn>2.7</mn><mo>⋅</mo><mn>1</mn><msup><mn>0</mn><mrow><mo>−</mo><mn>7</mn></mrow></msup></mrow><annotation encoding=\"application/x-tex\">F = \\frac{MS_B}{MS_W} = \\frac{SS_B/(t-1)}{SS_W/(N-t)} = \\frac{5.53/2}{0.85/15} = \\frac{2.765}{0.0567} = 48.8,\\qquad P = 2.7\\cdot10^{-7}</annotation></semantics></math></span>",
