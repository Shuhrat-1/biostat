 "display": {
  "(\\bar y_{1\\cdot}-\\bar y_{2\\cdot}) \\pm t_{0.975;\\,N-t}\\,\\mathrm{SED} = (0.22;\\ 0.88),\\qquad d = \\frac{\\bar y_{1\\cdot}-\\bar y_{2\\cdot}}{s_p} = 2.12": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mo stretchy=\"false\">(</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mn>1</mn><mo>⋅</mo></mrow></msub><mo>−</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mn>2</mn><mo>⋅</mo></mrow></msub><mo stretchy=\"false\">)</mo><mo>±</mo><msub><mi>t</mi><mrow><mn>0.975</mn><mo separator=\"true\">;</mo><mtext> </mtext><mi>N</mi><mo>−</mo><mi>t</mi></mrow></msub><mtext> </mtext><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">E</mi><mi mathvariant=\"normal\">D</mi></mrow><mo>=</mo><mo stretchy=\"false\">(</mo><mn>0.22</mn><mo separator=\"true\">;</mo><mtext> </mtext><mn>0.88</mn><mo stretchy=\"false\">)</mo><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi>d</mi><mo>=</mo><mfrac><mrow><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mn>1</mn><mo>⋅</mo></mrow></msub><mo>−</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mn>2</mn><mo>⋅</mo></mrow></msub></mrow><msub><mi>s</mi><mi>p</mi></msub></mfrac><mo>=</mo><mn>2.12</mn></mrow><annotation encoding=\"application/x-tex\">(\\bar y_{1\\cdot}-\\bar y_{2\\cdot}) \\pm t_{0.975;\\,N-t}\\,\\mathrm{SED} = (0.22;\\ 0.88),\\qquad d = \\frac{\\bar y_{1\\cdot}-\\bar y_{2\\cdot}}{s_p} = 2.12</annotation></semantics></math></span>",
  "F = \\frac{MS_B}{MS_W} = 27.8,\\qquad df = (2;\\ 27)": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>F</mi><mo>=</mo><mfrac><mrow><mi>M</mi><msub><mi>S</mi><mi>B</mi></msub></mrow><mrow><mi>M</mi><msub><mi>S</mi><mi>W</mi></msub></mrow></mfrac><mo>=</mo><mn>27.8</mn><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi>d</mi><mi>f</mi><mo>=</mo><mo stretchy=\"false\">(</mo><mn>2</mn><mo separator=\"true\">;</mo><mtext> </mtext><mn>27</mn><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">F = \\frac{MS_B}{MS_W} = 27.8,\\qquad df = (2;\\ 27)</annotation></semantics></math></span>",
  "F = \\frac{MS_B}{MS_W} = \\frac{SS_B/(t-1)}{SS_W/(N-t)} = \\frac{5.53/2}{0.85/15} = \\frac{2.765}{0.0567} = 48.8,\\qquad P = 2.7\\cdot10^{-7}": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>F</mi><mo>=</mo><mfrac><mrow><mi>M</mi><msub><mi>S</mi><mi>B</mi></msub></mrow><mrow><mi>M</mi><msub><mi>S</mi><mi>W</mi></msub></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>S</mi><msub><mi>S</mi><mi>B</mi></msub><mi mathvariant=\"normal\">/</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mi>S</mi><msub><mi>S</mi><mi>W</mi></msub><mi mathvariant=\"normal\">/</mi><mo stretchy=\"false\">(</mo><mi>N</mi><mo>−</mo><mi>t</mi><mo stretchy=\"false\">)</mo></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>5.53</mn><mi mathvariant=\"normal\">/</mi><mn>2</mn></mrow><mrow><mn>0.85</mn><mi mathvariant=\"normal\">/</mi><mn>15</mn></mrow></mfrac><mo>=</mo><mfrac><mn>2.765</mn><mn>0.0567</mn></mfrac><mo>=</mo><mn>48.8</mn><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi>P</mi><mo>=</mo><mn>2.7</mn><mo>⋅</mo><mn>1</mn><msup><mn>0</mn><mrow><mo>−</mo><mn>7</mn></mrow></msup></mrow><annotation encoding=\"application/x-tex\">F = \\frac{MS_B}{MS_W} = \\frac{SS_B/(t-1)}{SS_W/(N-t)} = \\frac{5.53/2}{0.85/15} = \\frac{2.765}{0.0567} = 48.8,\\qquad P = 2.7\\cdot10^{-7}</annotation></semantics></math></span>",
  "F_W = \\frac{\\sum_i w_i\\,(\\bar y_{i\\cdot}-\\bar y_w)^2/(t-1)}{1 + \\frac{2(t-2)}{t^2-1}\\,\\Lambda},\\qquad \\Lambda = \\sum_i \\frac{(1-w_i/W)^2}{n_i-1}": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msub><mi>F</mi><mi>W</mi></msub><mo>=</mo><mfrac><mrow><munder><mo>∑</mo><mi>i</mi></munder><msub><mi>w</mi><mi>i</mi></msub><mtext> </mtext><mo stretchy=\"false\">(</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mi>i</mi><mo>⋅</mo></mrow></msub><mo>−</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mi>w</mi></msub><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup><mi mathvariant=\"normal\">/</mi><mo stretchy=\"false\">(</mo><mi>t</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mn>1</mn><mo>+</mo><mfrac><mrow><mn>2</mn><mo stretchy=\"false\">(</mo><mi>t</mi><mo>−</mo><mn>2</mn><mo stretchy=\"false\">)</mo></mrow><mrow><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow></mfrac><mtext> </mtext><mi mathvariant=\"normal\">Λ</mi></mrow></mfrac><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi mathvariant=\"normal\">Λ</mi><mo>=</mo><munder><mo>∑</mo><mi>i</mi></munder><mfrac><mrow><mo stretchy=\"false\">(</mo><mn>1</mn><mo>−</mo><msub><mi>w</mi><mi>i</mi></msub><mi mathvariant=\"normal\">/</mi><mi>W</mi><msup><mo stretchy=\"false\">)</mo><mn>2</mn></msup></mrow><mrow><msub><mi>n</mi><mi>i</mi></msub><mo>−</mo><mn>1</mn></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">F_W = \\frac{\\sum_i w_i\\,(\\bar y_{i\\cdot}-\\bar y_w)^2/(t-1)}{1 + \\frac{2(t-2)}{t^2-1}\\,\\Lambda},\\qquad \\Lambda = \\sum_i \\frac{(1-w_i/W)^2}{n_i-1}</annotation></semantics></math></span>",
  "H_0:\\ \\tau_1 = \\tau_2 = \\dots = \\tau_t = 0": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msub><mi>H</mi><mn>0</mn></msub><mo>:</mo><mtext> </mtext><msub><mi>τ</mi><mn>1</mn></msub><mo>=</mo><msub><mi>τ</mi><mn>2</mn></msub><mo>=</mo><mo>⋯</mo><mo>=</mo><msub><mi>τ</mi><mi>t</mi></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding=\"application/x-tex\">H_0:\\ \\tau_1 = \\tau_2 = \\dots = \\tau_t = 0</annotation></semantics></math></span>",
  "P = \\frac{1 + \\#\\{\\,b:\\ F^*_b \\ge F\\,\\}}{B+1},\\qquad B = 999,\\quad P = 0.001": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>P</mi><mo>=</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mi mathvariant=\"normal\">#</mi><mo stretchy=\"false\">{</mo><mtext> </mtext><mi>b</mi><mo>:</mo><mtext> </mtext><msubsup><mi>F</mi><mi>b</mi><mo>∗</mo></msubsup><mo>≥</mo><mi>F</mi><mtext> </mtext><mo stretchy=\"false\">}</mo></mrow><mrow><mi>B</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi>B</mi><mo>=</mo><mn>999</mn><mo separator=\"true\">,</mo><mspace width=\"1em\"/><mi>P</mi><mo>=</mo><mn>0.001</mn></mrow><annotation encoding=\"application/x-tex\">P = \\frac{1 + \\#\\{\\,b:\\ F^*_b \\ge F\\,\\}}{B+1},\\qquad B = 999,\\quad P = 0.001</annotation></semantics></math></span>",
  "\\eta^2 = \\frac{SS_B}{SS_T} = 0.87,\\qquad \\omega^2 = \\frac{SS_B-(t-1)\\,MS_W}{SS_T+MS_W} = 0.84": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msup><mi>η</mi><mn>2</mn></msup><mo>=</mo><mfrac><mrow><mi>S</mi><msub><mi>S</mi><mi>B</mi></msub></mrow><mrow><mi>S</mi><msub><mi>S</mi><mi>T</mi></msub></mrow></mfrac><mo>=</mo><mn>0.87</mn><mo separator=\"true\">,</mo><mspace width=\"2em\"/><msup><mi>ω</mi><mn>2</mn></msup><mo>=</mo><mfrac><mrow><mi>S</mi><msub><mi>S</mi><mi>B</mi></msub><mo>−</mo><mo stretchy=\"false\">(</mo><mi>t</mi><mo>−</mo><mn>1</mn><mo stretchy=\"false\">)</mo><mtext> </mtext><mi>M</mi><msub><mi>S</mi><mi>W</mi></msub></mrow><mrow><mi>S</mi><msub><mi>S</mi><mi>T</mi></msub><mo>+</mo><mi>M</mi><msub><mi>S</mi><mi>W</mi></msub></mrow></mfrac><mo>=</mo><mn>0.84</mn></mrow><annotation encoding=\"application/x-tex\">\\eta^2 = \\frac{SS_B}{SS_T} = 0.87,\\qquad \\omega^2 = \\frac{SS_B-(t-1)\\,MS_W}{SS_T+MS_W} = 0.84</annotation></semantics></math></span>",
  "\\mathrm{SE}(\\bar y_{i\\cdot}) = \\sqrt{\\frac{MS_W}{n_i}},\\quad \\mathrm{SED} = \\sqrt{MS_W\\left(\\frac1{n_i}+\\frac1{n_k}\\right)},\\quad \\bar y_{i\\cdot} \\pm t_{0.975;\\,N-t}\\,\\mathrm{SE},\\quad \\mathrm{LSD} = t_{0.975;\\,N-t}\\,\\mathrm{SED}": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">E</mi></mrow><mo stretchy=\"false\">(</mo><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mi>i</mi><mo>⋅</mo></mrow></msub><mo stretchy=\"false\">)</mo><mo>=</mo><msqrt><mfrac><mrow><mi>M</mi><msub><mi>S</mi><mi>W</mi></msub></mrow><msub><mi>n</mi><mi>i</mi></msub></mfrac></msqrt><mo separator=\"true\">,</mo><mspace width=\"1em\"/><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">E</mi><mi mathvariant=\"normal\">D</mi></mrow><mo>=</mo><msqrt><mrow><mi>M</mi><msub><mi>S</mi><mi>W</mi></msub><mrow><mo fence=\"true\">(</mo><mfrac><mn>1</mn><msub><mi>n</mi><mi>i</mi></msub></mfrac><mo>+</mo><mfrac><mn>1</mn><msub><mi>n</mi><mi>k</mi></msub></mfrac><mo fence=\"true\">)</mo></mrow></mrow></msqrt><mo separator=\"true\">,</mo><mspace width=\"1em\"/><msub><mover accent=\"true\"><mi>y</mi><mo>ˉ</mo></mover><mrow><mi>i</mi><mo>⋅</mo></mrow></msub><mo>±</mo><msub><mi>t</mi><mrow><mn>0.975</mn><mo separator=\"true\">;</mo><mtext> </mtext><mi>N</mi><mo>−</mo><mi>t</mi></mrow></msub><mtext> </mtext><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">E</mi></mrow><mo separator=\"true\">,</mo><mspace width=\"1em\"/><mrow><mi mathvariant=\"normal\">L</mi><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">D</mi></mrow><mo>=</mo><msub><mi>t</mi><mrow><mn>0.975</mn><mo separator=\"true\">;</mo><mtext> </mtext><mi>N</mi><mo>−</mo><mi>t</mi></mrow></msub><mtext> </mtext><mrow><mi mathvariant=\"normal\">S</mi><mi mathvariant=\"normal\">E</mi><mi mathvariant=\"normal\">D</mi></mrow></mrow><annotation encoding=\